# REVALORA — Supabase Environment Configuration
# Copy this file to .env.local and populate with your Supabase project credentials.
# NEVER commit .env.local or expose service_role / secret keys to the browser.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

